<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="402dp"
        android:layout_height="706dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/adresBtn"
            android:layout_width="251dp"
            android:layout_height="86dp"
            android:layout_marginStart="156dp"
            android:layout_marginTop="208dp"
            android:layout_marginEnd="156dp"
            android:text="WYWOŁAJ APLIKACJE OBSŁUGUJĄCĄ PODANY ADRES URL"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/firstnameLastnameBtn"
            android:layout_width="251dp"
            android:layout_height="86dp"
            android:layout_marginStart="156dp"
            android:layout_marginTop="113dp"
            android:layout_marginEnd="156dp"
            android:text="WYWOŁAJ AKTYWNOŚĆ Z IMIENIEM I NAZWISKIEM"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/geoBtn"
            android:layout_width="251dp"
            android:layout_height="86dp"
            android:layout_marginStart="156dp"
            android:layout_marginTop="308dp"
            android:layout_marginEnd="156dp"
            android:text="WYŚWIETL AKTYWNOŚĆ Z DANYM POŁOŻENIEM (GEO:)"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.503"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputUrl"
            android:layout_width="354dp"
            android:layout_height="82dp"
            android:layout_marginStart="27dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="21dp"
            android:layout_marginBottom="207dp"
            android:hint="http://"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/geoBtn" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>